NODE_ENV=production
HOST=127.0.0.1
PORT=3001
SITE_URL=https://your-domain.example
TIMEZONE=Africa/Kigali
DATABASE_PATH=/var/lib/affiliate-engine/data/affiliate.sqlite
UPLOAD_DIR=/var/lib/affiliate-engine/uploads
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_THE_ORIGINAL_64_HEX_KEY
SESSION_HOURS=8
TRUST_PROXY=true
# Start paused until outbound email and restored queues have been reviewed.
PREVIEW_ONLY=true
