{
  "name": "affiliate-engine",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "predev": "npm run build -w shared",
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "pretypecheck": "npm run build -w shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w server",
    "pretest": "npm run build -w shared",
    "test": "npm run test -w server",
    "start": "npm run start -w server",
    "security:setup": "npm run security:setup -w server",
    "admin:setup": "npm run admin:setup -w server",
    "admin:reset": "npm run admin:reset -w server",
    "demo:seed": "npm run demo:seed -w server",
    "design:assets": "npm run design:assets -w server",
    "worker:transactional": "npm run worker:transactional -w server",
    "worker:marketing": "npm run worker:marketing -w server",
    "prepreview": "npm run build -w shared",
    "preview": "concurrently -k -n api,web \"npm run preview -w server\" \"npm run dev -w client\"",
    "repository:check": "node scripts/repository-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
